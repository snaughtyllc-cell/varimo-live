# Railway service variables for varimo Studio (control plane).
# Copy into the Railway service — never commit real values.

# Public URL after `railway domain` (used for Drive OAuth redirect).
# PUBLIC_URL=https://varyforge-studio.up.railway.app

# Persist uploads / gallery / OAuth token. Mount a Railway volume at /data.
DATA_DIR=/data/vmdata

# local = render on this CPU box (works immediately, no GPU).
# runpod = upload source to object storage, render on RunPod serverless.
# Omit to auto-select: runpod when all RUNPOD_* + R2_* vars are set.
# VARIANT_RUNNER=runpod
# fast = FFmpeg uniqueness (default per job). hq = Real-ESRGAN (Phase 8).
# Studio Advanced → Quality can override per Generate. Env is the fallback.
# VARIANT_QUALITY_MODE=fast

# --- RunPod serverless engine (required for VARIANT_RUNNER=runpod) ---
# RUNPOD_ENDPOINT_ID=          # HQ (4090) endpoint
# RUNPOD_FAST_ENDPOINT_ID=     # Fast CPU endpoint (optional; omit → Fast 20s use GPU)
# RUNPOD_API_KEY=
# Object store: Cloudflare R2, AWS S3, RunPod S3, or a Railway bucket (S3 API).
# R2_ENDPOINT=
# R2_BUCKET=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=

# Keep finished Generate jobs for 24 hours per workspace (an 8-pack is one job).
# 0 disables age prune. Default 24. Opening Gallery / hydrate also prune.
# VARIANT_GALLERY_KEEP_HOURS=24
# Optional count cap on finished jobs (default 0 = off). When set, oldest
# remaining finished jobs over the cap are deleted from the Railway volume
# and from R2 inputs/{source_id}/ + outputs/{source_id}/.
# VARIANT_GALLERY_KEEP_JOBS=0

# Invite-only Google login (same OAuth client as Drive). Auth stays off until
# VARIANT_AUTH_ADMIN_EMAIL is set. First admin login claims existing packs.
# VARIANT_AUTH_ADMIN_EMAIL=snaughtyllc@gmail.com
# VARIANT_AUTH_SECRET=
# Optional override; default is {PUBLIC_URL}/api/auth/google/callback
# VARIANT_AUTH_OAUTH_REDIRECT_URI=https://varyforge-studio-production.up.railway.app/api/auth/google/callback

# --- Google Drive export (optional) ---
# VARIANT_DRIVE_OAUTH_CLIENT_ID=
# VARIANT_DRIVE_OAUTH_CLIENT_SECRET=
# VARIANT_DRIVE_OAUTH_REDIRECT_URI=https://varyforge-studio-production.up.railway.app/api/drive/oauth/callback
# Mailbox operators share folders with (never a personal Gmail). Default drive@varyforge.app
# VARIANT_DRIVE_SHARE_EMAIL=drive@varyforge.app
# Pin the Drop Ledger spreadsheet so labels survive deploys (optional).
# Create via Studio → Settings → Drive → Ensure sheet, then paste the id from
# the sheet URL. Does not auto-tune uniqueness.
# VARIANT_DROP_SHEET_ID=

# --- Studio Generate captions (Anthropic Haiku 4.5) ---
# ANTHROPIC_API_KEY=           # or VARIANT_ANTHROPIC_API_KEY
# VARIANT_CAPTION_MODEL=claude-haiku-4-5
# Retired claude-3-5-haiku-* values are remapped to 4.5 in code.
# OpenAI is fallback only if Anthropic is unset or the request fails.

# --- Instagram Insights (owners only; testers-only Meta app, no App Review) ---
# VARIANT_IG_APP_ID=
# VARIANT_IG_APP_SECRET=
# Optional override; default is {PUBLIC_URL}/api/instagram/oauth/callback
# VARIANT_IG_REDIRECT_URI=https://varyforge-studio-production.up.railway.app/api/instagram/oauth/callback
